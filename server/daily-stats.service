[Unit]
Description=空气质量日统计定时任务
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/air-quality/server
ExecStart=/usr/bin/python3 /home/air-quality/server/daily_stats_job.py
Restart=always
RestartSec=30

# ===== 按你的实际情况修改下面这 5 行 =====
Environment="MYSQL_HOST=localhost"
Environment="MYSQL_USER=root"
Environment="MYSQL_PASSWORD="
Environment="MYSQL_DATABASE=air_quality"
Environment="LOG_DIR=/home/air-quality/server"

[Install]
WantedBy=multi-user.target
